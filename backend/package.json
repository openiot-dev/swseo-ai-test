{
  "name": "backend",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "build": "rm -rf dist && esbuild src/handlers/*.ts --bundle --platform=node --target=node20 --outdir=dist --external:@aws-sdk/* --minify",
    "typecheck": "tsc --noEmit",
    "tf:init": "cd terraform && terraform init",
    "tf:plan": "npm run build && cd terraform && terraform plan",
    "tf:apply": "npm run build && cd terraform && terraform apply",
    "tf:destroy": "cd terraform && terraform destroy"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.65.0"
  },
  "devDependencies": {
    "@types/aws-lambda": "^8.10.145",
    "@types/node": "^20.14.0",
    "esbuild": "^0.23.0",
    "typescript": "^5.5.0"
  }
}
